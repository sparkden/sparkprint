{
  "name": "@sparkprint/electron",
  "private": true,
  "version": "0.1.0",
  "description": "SparkPrint desktop app — native wrapper around the SparkPrint web app.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.sparkden.sparkprint",
    "productName": "SparkPrint",
    "files": ["main.js", "preload.js", "icon.*"],
    "mac": { "category": "public.app-category.education" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage", "category": "Education" }
  }
}
