# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL="postgres://user:password@host:5432/sparkcloud"
# Long random string — signs/encrypts sessions and Bambu tokens at rest. REQUIRED in prod.
# Generate: openssl rand -base64 48
APP_SECRET="change-me-to-a-long-random-string"

# ── Storage ───────────────────────────────────────────────────────────────────
# Where uploaded models / thumbnails / sliced output are stored (mount a volume here).
STORAGE_DIR="/data/storage"

# ── Bambu connectivity ──────────────────────────────────────────────────────────
# "mock" = demo printers (no credentials). "cloud" = real Bambu cloud account + MQTT.
BAMBU_MODE="mock"

# ── Behind a reverse proxy (Coolify/Traefik/Nginx) ──────────────────────────────
# Either set ORIGIN to your public URL, OR let adapter-node derive it from proxy headers
# (the Dockerfile sets PROTOCOL_HEADER/HOST_HEADER for you). One of these is REQUIRED in
# production or form submissions are rejected as cross-site.
# ORIGIN="https://print.yourschool.edu"

# Max upload size in bytes (models). Default 100 MB. (set in the Docker image)
# BODY_SIZE_LIMIT="104857600"
